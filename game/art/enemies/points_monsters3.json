 "_notes": {
  "buckle": "buckle_shell (see-through ice) goes over any frame while the rime holds, shifted by that frame's shell_dx, shell_dy (frame units).",
  "creep": "Drawn head-up with its tail end on the feet anchor (64, 122) and its lane along frame x 64, the skull about 40 px up (it fills its 16 x 40 box). Crawling down its lane, flip it vertically about the top of its box. Off the lane (a flat lane or knocked onto the floor) turn it 90 deg with the head toward its heading; its tail is at the anchor, so shift the sprite back by half its length (20 px) to centre it, and 8 px up (its body is 16 px thick). creep_fall is the knocked-off Creepbone on its back; it has no dizzy stars (they would lie sideways once it is turned): draw them upright over its `belly`.",
  "owl": "Draw owl_body, then one head frame over it at the same anchor (the head sits on the body at `head`); the head frames swap to sweep (look_l, look_c, look_r), and `cone` is where the eye cone starts on each. owl_broken is the whole owl.",
  "spur": "Centred on its hub (64, 64): it rolls along edges, so turn spur_roll / _catch / _hit about its middle (sprite.rotation = spin); its teeth reach 28 units (14 px) from the hub, 31 (15.5 px) bristling in the catch. Then draw the matching face overlay upright (rotation 0) at the same anchor: spur_face over roll, spur_face_catch over catch (the jam and the caught window), spur_face_hit over hit. It covers the cog's own hub face exactly, so the stern face stays the right way up; its eye1 / eye2 are the glow eyes, unturned. The frames draw no sparks or trail: code puts the sparks at the contact point."
 },
 "_roles": {
  "buckle": "idle; walk1/walk2; both tells (Frost Stomp and Shield Slam): raise; stomp; slam; thawed (the rime shattered); hit (no rime); and buckle_shell over any frame while the rime holds",
  "creep": "crawl1/crawl2; the tell: coil; lunge; stretched: lunge; knocked off and dazed: fall; hit",
  "hound": "prowl: prowl1/prowl2; the chase tell: howl; chase: run1/run2; the tell: crouch; pounce; land (open); pant (tired); hit",
  "owl": "owl_body with a head over it (same anchor): the sweep look_l / look_c / look_r, the alarm screech, hit; broken is the whole owl (its death)",
  "rootling": "buried: mound; the tell: swell; pop; dazed; walking: walk1/walk2; hit; digging back in: swell then mound",
  "spur": "roll (turn the sprite as it rolls) under spur_face; the jam tell and the caught window: catch (with the re-spin) under spur_face_catch; hit under spur_face_hit",
  "tick": "march1/march2 on the tick; the tell: wind; charge; dizzy (after a wall) and rundown; hit",
  "weepcap": "idle (sway it); the tell: inhale; puff; hit; die"
 },
 "_tells": {
  "creep_coil.glint": "the coil tell: the eye glint (a light r 18)",
  "creep_fall.belly": "the middle of its body, lying on its back: draw the dizzy stars upright over it",
  "creep_lunge.bite": "the jaws at the front of the lunge",
  "hound_crouch.teeth": "the crouch tell: the glint on the bared teeth",
  "hound_howl.flare": "the lantern eye flaring (a green light r 30): the one lit socket",
  "hound_pounce.bite": "the jaws, leading the pounce",
  "rootling_mound.leaves": "the two leaves poking out of the mound",
  "rootling_pop.column": "the middle of the pop column (22 x 40 px from the floor)",
  "rootling_swell.glint": "the swell tell: the green glint (a light r 22) over the mound",
  "spur_*.hub": "the hub (the middle of the turning and of the face overlay)",
  "weepcap_*.gills": "the gills under the cap: the inhale glow (a violet light r 26)",
  "weepcap_puff.burst": "the middle of the puff burst (r 36 px)"
 },
