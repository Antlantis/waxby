 "_notes": {
  "coil": "W6: the head faces right; chain coil_seg frames behind it from the neck (about 20 px apart) and end with coil_tail (its fin trails behind, to the left when the head faces right). coil_hit is the head recoiling; coil_head_rest the head resting on an islet edge (its jaw's underside flat on the ground). Once the candle is knocked loose (flames 0), show the _bare twin of each head frame instead.",
  "hushling": "W6: ink with the silver rim (4 units). The ink ends at y 120; its silver rim reaches the floor line.",
  "maw": "W6: a porcelain mask with the silver rim. It floats: anchored on its middle.",
  "mite": "Neutral glass: tint it by the sprite modulate (enemy.gd tint) with one of _tints, picked by hash(cell). Its hit box is 40 units (20 px) tall (spec: at least 20), reaching up over its 14 px dome.",
  "pane": "Neutral glass: tint it as the Glassmite. pane_turn is the turn tell (halfway), pane_edge the 8 px edge-on window (full damage).",
  "unwick": "No frames: the Unwick is the player's own rig (wick_rig.gd) in black with a silver rim."
 },
 "_omens": {
  "Echoing": "omen_echo_dial at its feet, scaled so its half-width (48 units) is size.x * 0.75 + 4 px (the elite ring's width), flattened as drawn; the hand is a line from the middle to the dial, one tick every W4 beat (0.536 s). The echo itself: the monster's frame redrawn at the strike place in e8fcff at alpha 0.45, its box outlined from the first strike.",
  "Glassed": "omen_glassed centred on center(), scaled so its 96-unit width is max(size) * 1.35 px, alpha 0.5 + 0.2 * sin(ftime * 3); gone when the shell breaks (spark burst, omen_glass_break).",
  "Hushed": "A violet rim: the frame redrawn 4 times offset by 1 px (up, down, left, right) in 6a5a9a at alpha 0.35 under the eye glints, plus 3 omen_hush_mote orbiting slowly (r = size.x * 0.7); its eyes go dark.",
  "Sporebound": "Up to 6 omen_spore_mote drifting up from the body (rise 14 px/s, sway 3 px, 1.6 s life, scale 0.12-0.2), and its eyes glow green (eye points drawn in b8e070).",
  "frames": [
   "omen_glassed",
   "omen_echo_dial",
   "omen_spore_mote",
   "omen_hush_mote"
  ],
  "how": "Glow-layer overlays for the four new Omens (P1), loaded in _ready. omen_glassed and omen_echo_dial are 128-unit frames anchored on their middle (64, 64); the motes are 32-unit frames (64 px) anchored on their middle. Colours: Sporebound green b8e070, Echoing frost e8fcff (W4 tell accent), Glassed prism white f8f0ff, Hushed violet 6a5a9a."
 },
 "_rim": {
  "w5": "#ffeccc",
  "w6": "#c8c8f0",
  "w6_width_units": 4.0
 },
 "_roles": {
  "coil": "swimming: coil_head_closed; the leap bite: coil_head_open; the rest window: coil_head_rest; hit: coil_hit; the same four as coil_head_closed_bare, _head_open_bare, _head_rest_bare, coil_hit_bare once its candle is knocked loose; the body: coil_seg links and coil_tail",
  "gust": "idle1/idle2 (the bob); the tell: inhale; blow; hit",
  "hushling": "idle1/idle2; the tell: crouch; lunge; open after it: blink; death: pop",
  "maw": "idle; the Swallow and Gulp tells: strain (tipped back, the jaw stretched, the ties flared), then open; the gulp: open; a hit in a tell: choke (it spits the light); hit",
  "mite": "walk1/walk2; the tell: gnaw; hit",
  "pane": "advance: face1/face2; the tell: turn; edge-on (the lunge and the recover window): edge; Glass Cut: cut; face-on hit: hit; death: shatter",
  "refractor": "track: idle1/idle2; lock: charge; fire; hit (code draws the aim line and the beam from lens)"
 },
 "_tells": {
  "coil_*.bite": "the jaws' front (the bite)",
  "coil_*.lure": "the stolen candle's flame (the lure light, r 30); the _bare frames have none",
  "coil_*.neck": "where the first segment joins the head",
  "coil_seg.top": "the segment's fin",
  "coil_tail.tip": "the tail fin's tip",
  "gust_*.mouth": "the mouth the gust blows from (the band runs forward from it)",
  "gust_blow.gust": "the far end of the drawn gust lines (off the art)",
  "hushling_lunge.mouth": "the mouth at the front of the lunge",
  "maw_*.mouth": "the stitched mouth: Swallow and Gulp pull toward it; choke spits the light from it",
  "mite_gnaw.jaws": "the gnaw tell: the mandibles tapping the glass (the crack runs from here)",
  "pane_cut.arc": "the middle of the swing's glass smear (the 60 x 40 arc runs from over the head down to the tip)",
  "pane_cut.blade": "the sword tip at the end of the Glass Cut's swing (low in front)",
  "pane_edge.glint": "edge-on, the glint running up the lead",
  "pane_turn.glint": "the turn tell: the glint running along the lead",
  "refractor_*.beam": "the lock and fire glint round the lens, where code starts the aim line and the beam (the frames draw no line: it aims at any angle)",
  "refractor_*.lens": "the eye in its core: the beam starts here"
 },
